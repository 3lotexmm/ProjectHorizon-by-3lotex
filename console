    if exit_code == 0:
        msg = "✓ БОТ КОРРЕКТНО ОСТАНОВЛЕН"
        padding = (width - len(msg)) // 2
        print(f"{C.CYAN}{C.BOLD}║{C.RESET}{' ' * padding}{C.GREEN}{C.BOLD}{msg}{C.RESET}{' ' * (width - padding - len(msg))}{C.CYAN}{C.BOLD}║{C.RESET}")
    else:
        msg = f"✗ ОШИБКА ПРИ РАБОТЕ БОТА (Код: {exit_code})"
        padding = (width - len(msg)) // 2
        print(f"{C.CYAN}{C.BOLD}║{C.RESET}{' ' * padding}{C.RED}{C.BOLD}{msg}{C.RESET}{' ' * (width - padding - len(msg))}{C.CYAN}{C.BOLD}║{C.RESET}")
    

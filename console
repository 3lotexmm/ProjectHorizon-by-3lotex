class C:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    BLACK = "\033[30m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"
    WHITE = "\033[37m"

def clear_screen():
    os.system("cls" if platform.system() == "Windows" else "clear")

def progress_bar(value, total=100, width=35):
    filled = int(width * value / total)
    bar = f"{C.GREEN}{'█' * filled}{C.DIM}{'░' * (width - filled)}{C.RESET}"
    percent = f"{C.BOLD}{C.WHITE}{value:>3}%{C.RESET}"
    return f"[{bar}] {percent}"

def check_dependencies():
    deps = []
    try:
        with open("requirements.txt", "r", encoding="utf-8") as f:
            deps = [line.strip() for line in f if line.strip() and not line.startswith("#")]
    except FileNotFoundError:
        return 0, 0, []
    
    installed = 0
    missing = []
    
    for dep in deps:
        pkg_name = dep.split("==")[0].split(">=")[0].split("[")[0].strip()
        pkg_name = pkg_name.replace("-", "_")
        try:
            importlib.import_module(pkg_name)
            installed += 1
        except ImportError:
            missing.append(dep)
    
    return installed, len(deps), missing

def check_redis():
    try:
        import redis
        r = redis.Redis(host="localhost", port=6379, db=0)
        r.ping()
        return True
    except:
        return False


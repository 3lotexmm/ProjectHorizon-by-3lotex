    padding = (width - len(msg2)) // 2
    print(f"{C.CYAN}{C.BOLD}║{C.RESET}{' ' * padding}{C.DIM}{msg2}{C.RESET}{' ' * (width - padding - len(msg2))}{C.CYAN}{C.BOLD}║{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}╚{'═' * width}╝{C.RESET}")
    print()


    print(f"{C.BOLD}{C.WHITE}┌── ПРОВЕРКА ЗАВИСИМОСТЕЙ {'─' * (width - 25)}{C.RESET}")
    print(f"{C.WHITE}│{C.RESET}")
    
    installed, total, missing = check_dependencies()
    
    if total == 0:
        print(f"{C.WHITE}│{C.RESET}  {C.YELLOW}⚠ requirements.txt не найден{C.RESET}")
        print(f"{C.BOLD}{C.WHITE}└{'─' * width}{C.RESET}")
        return
    
    for i in range(101):
        sys.stdout.write(f"\r{C.WHITE}│{C.RESET}  {progress_bar(i)}")
        sys.stdout.flush()
        time.sleep(0.008)
    print()
    
    if missing:
        print(f"{C.WHITE}│{C.RESET}  {C.YELLOW}⚠ Установка недостающих зависимостей...{C.RESET}")
        subprocess.run([sys.executable, "-m", "pip", "install", "-r", "requirements.txt"], 
                      capture_output=True)
        print(f"{C.WHITE}│{C.RESET}  {C.GREEN}✓ Зависимости установлены{C.RESET}")
    else:
        print(f"{C.WHITE}│{C.RESET}  {C.GREEN}✓ Все {total} зависимостей установлены{C.RESET}")
    
    print(f"{C.WHITE}│{C.RESET}")

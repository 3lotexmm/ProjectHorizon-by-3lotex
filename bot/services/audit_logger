import json
import asyncio
from typing import Optional
import aiosqlite
import redis.asyncio as redis
from ..core.config import SQLITE_PATH, REDIS_HOST, REDIS_PORT, REDIS_DB
from ..core.logger import logger

class AuditLoggerService:
    STREAM_NAME = "audit_events"
    GROUP_NAME = "audit_consumers"
    CONSUMER_NAME = "worker-1"
    BATCH_SIZE = 10

    def __init__(self):
        self.redis = redis.Redis(
            host=REDIS_HOST,
            port=REDIS_PORT,
            db=REDIS_DB,
            decode_responses=True,
        )
        self.db: Optional[aiosqlite.Connection] = None
        self._task: Optional[asyncio.Task] = None

    async def start(self):
        await self._init_db()
        await self._init_consumer_group()
        self._task = asyncio.create_task(self._run_loop(), name="audit-logger")
        logger.info("AuditLoggerService started")

    async def stop(self):
        if self._task:
            self._task.cancel()
            try:
                await self._task
            except asyncio.CancelledError:
                pass
        if self.db:
            await self.db.close()
        await self.redis.close()
        logger.info("AuditLoggerService stopped")

    async def _init_db(self):
        self.db = await aiosqlite.connect(SQLITE_PATH)
        self.db.row_factory = aiosqlite.Row
        await self.db.executescript("""
            CREATE TABLE IF NOT EXISTS audit_logs (
                id          INTEGER PRIMARY KEY AUTOINCREMENT,
                guild_id    INTEGER NOT NULL,
                log_type    TEXT    NOT NULL,
                action      TEXT    NOT NULL,
                actor_id    INTEGER,
                target_id   INTEGER,
                source      TEXT    DEFAULT 'manual',
                details     TEXT    NOT NULL,
                created_at  TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            );
            CREATE INDEX IF NOT EXISTS idx_audit_guild_time ON audit_logs(guild_id, created_at);
            CREATE INDEX IF NOT EXISTS idx_audit_type_time   ON audit_logs(log_type, created_at);
            CREATE INDEX IF NOT EXISTS idx_audit_target      ON audit_logs(target_id);
            CREATE INDEX IF NOT EXISTS idx_audit_actor       ON audit_logs(actor_id);
        """)
        await self.db.commit()
        logger.info("AuditLoggerService: SQLite tables ready")

    async def _init_consumer_group(self):
        try:
            await self.redis.xgroup_create(
                self.STREAM_NAME, self.GROUP_NAME, id="0", mkstream=True
            )
            logger.info(f"Consumer group '{self.GROUP_NAME}' created")
        except redis.ResponseError as e:
            if "BUSYGROUP" not in str(e):
                raise

    async def _run_loop(self):
        logger.info("AuditLoggerService: processing loop started")
        while True:
            try:
                messages = await self.redis.xreadgroup(
                    groupname=self.GROUP_NAME,
                    consumername=self.CONSUMER_NAME,
                    streams={self.STREAM_NAME: ">"},
                    count=self.BATCH_SIZE,
                    block=2000,
                )
                if not messages:
                    continue

                for stream, entries in messages:
                    for message_id, fields in entries:
                        await self._process_message(message_id, fields)
                        await self.redis.xack(
                            self.STREAM_NAME, self.GROUP_NAME, message_id
                        )
            except asyncio.CancelledError:
                logger.info("AuditLoggerService: loop cancelled")
                raise
            except Exception as e:
                logger.error(f"AuditLoggerService error: {e}", exc_info=True)
                await asyncio.sleep(1)

    async def _process_message(self, message_id: str, fields: dict) -> None:
        try:
            guild_id = int(fields["guild_id"])
            log_type = fields["log_type"]
            action = fields["action"]
            actor_id = int(fields["actor_id"]) if fields["actor_id"] else None
            target_id = int(fields["target_id"]) if fields["target_id"] else None
            source = fields.get("source", "manual")
            details = fields["details"]

            await self.db.execute(
                """
                INSERT INTO audit_logs (guild_id, log_type, action, actor_id, target_id, source, details)
                VALUES (?, ?, ?, ?, ?, ?, ?)
                """,
                (guild_id, log_type, action, actor_id, target_id, source, details),
            )
            await self.db.commit()
            logger.debug(f"Audit event saved: {log_type}/{action} (msg={message_id})")
        except Exception as e:
            logger.error(f"Failed to process audit message {message_id}: {e}", exc_info=True)
            raise

import aiosqlite
from typing import Optional, Any
from ..core.config import SQLITE_PATH
from ..core.logger import logger

class DatabaseService:
    def __init__(self):
        self.db: Optional[aiosqlite.Connection] = None

    async def connect(self):
        self.db = await aiosqlite.connect(SQLITE_PATH)
        self.db.row_factory = aiosqlite.Row
        await self._create_tables()
        logger.info("DatabaseService connected and tables ready")

    async def _create_tables(self):
        # Создаём таблицы БЕЗ индекса на application_number
        await self.db.executescript("""
            CREATE TABLE IF NOT EXISTS guild_settings (
                guild_id   INTEGER NOT NULL,
                key        TEXT    NOT NULL,
                value      TEXT,
                updated_by INTEGER,
                updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                PRIMARY KEY (guild_id, key)
            );

            CREATE TABLE IF NOT EXISTS tickets (
                id            INTEGER PRIMARY KEY AUTOINCREMENT,
                guild_id      INTEGER NOT NULL,
                ticket_number INTEGER NOT NULL,
                channel_id    INTEGER NOT NULL,
                creator_id    INTEGER NOT NULL,
                assigned_to   INTEGER,
                status        TEXT    NOT NULL DEFAULT 'open',
                subject       TEXT,
                created_at    TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                closed_at     TIMESTAMP,
                closed_by     INTEGER,
                UNIQUE(guild_id, ticket_number)
            );
            CREATE INDEX IF NOT EXISTS idx_tickets_guild_status ON tickets(guild_id, status);
            CREATE INDEX IF NOT EXISTS idx_tickets_creator      ON tickets(creator_id);
            CREATE INDEX IF NOT EXISTS idx_tickets_assigned     ON tickets(assigned_to);

            CREATE TABLE IF NOT EXISTS staff_members (
                guild_id  INTEGER NOT NULL,
                user_id   INTEGER NOT NULL,
                role      TEXT    NOT NULL,
                added_by  INTEGER NOT NULL,
                added_at  TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                is_active INTEGER NOT NULL DEFAULT 1,
                PRIMARY KEY (guild_id, user_id)
            );
            CREATE INDEX IF NOT EXISTS idx_staff_guild_active ON staff_members(guild_id, is_active);

            CREATE TABLE IF NOT EXISTS staff_history (
                id           INTEGER PRIMARY KEY AUTOINCREMENT,
                guild_id     INTEGER NOT NULL,
                user_id      INTEGER NOT NULL,
                action       TEXT    NOT NULL,
                old_role     TEXT,
                new_role     TEXT,
                performed_by INTEGER NOT NULL,
                reason       TEXT,
                created_at   TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            );
            CREATE INDEX IF NOT EXISTS idx_staff_history_guild_user ON staff_history(guild_id, user_id);

            CREATE TABLE IF NOT EXISTS staff_applications (
                id           INTEGER PRIMARY KEY AUTOINCREMENT,
                guild_id     INTEGER NOT NULL,
                user_id      INTEGER NOT NULL,
                role         TEXT    NOT NULL,
                age          INTEGER,
                experience   TEXT,
                about        TEXT,
                timezone     TEXT,
                availability TEXT,
                status       TEXT    DEFAULT 'pending',
                application_number INTEGER,
                reject_reason TEXT,
                reviewed_by  INTEGER,
                reviewed_at  TIMESTAMP,
                created_at   TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            );
            CREATE INDEX IF NOT EXISTS idx_staff_apps_guild_status ON staff_applications(guild_id, status);

            CREATE TABLE IF NOT EXISTS warnings (
                id           INTEGER PRIMARY KEY AUTOINCREMENT,
                guild_id     INTEGER NOT NULL,
                user_id      INTEGER NOT NULL,
                moderator_id INTEGER NOT NULL,
                reason       TEXT,
                created_at   TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            );
            CREATE INDEX IF NOT EXISTS idx_warnings_guild_user ON warnings(guild_id, user_id);
        """)
        
        # Миграция: добавляем колонки, если их нет
        try:
            await self.db.execute("ALTER TABLE staff_applications ADD COLUMN application_number INTEGER")
            logger.info("Migration: added application_number")
        except:
            pass
        
        try:
            await self.db.execute("ALTER TABLE staff_applications ADD COLUMN reject_reason TEXT")
            logger.info("Migration: added reject_reason")
        except:
            pass
        
        # Создаём индекс ПОСЛЕ миграции
        try:
            await self.db.execute("CREATE INDEX IF NOT EXISTS idx_staff_apps_guild_number ON staff_applications(guild_id, application_number)")
        except:
            pass
        
        await self.db.commit()
        logger.info("DatabaseService: schema initialized")

    async def close(self):
        if self.db:
            await self.db.close()
            logger.info("DatabaseService closed")

    async def fetchone(self, query: str, *params) -> Optional[aiosqlite.Row]:
        cursor = await self.db.execute(query, params)
        row = await cursor.fetchone()
        await cursor.close()
        return row

    async def fetchall(self, query: str, *params) -> list[aiosqlite.Row]:
        cursor = await self.db.execute(query, params)
        rows = await cursor.fetchall()
        await cursor.close()
        return rows

    async def execute(self, query: str, *params) -> None:
        await self.db.execute(query, params)
        await self.db.commit()

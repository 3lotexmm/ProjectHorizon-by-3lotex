class StaffPrivateVerdictView(discord.ui.View):
    def __init__(self, bot: commands.Bot, app_number: int, user_id: int, role: str, role_name: str):
        # timeout=None = кнопки никогда не пропадут сами по себе
        super().__init__(timeout=None)
        self.bot = bot
        self.app_number = app_number
        self.user_id = user_id
        self.role = role
        self.role_name = role_name

    @discord.ui.button(label="✅ Одобрить", style=discord.ButtonStyle.success)
    async def accept_button(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.defer()

        if not self.is_admin(interaction.user):
            return await interaction.followup.send("⛔ У вас нет прав для вердикта.", ephemeral=True)

        row = await self.bot.db.fetchone("SELECT * FROM staff_applications WHERE application_number = ? AND guild_id = ? AND status = 'pending'", self.app_number, interaction.guild.id)
        if not row:
            await interaction.message.edit(view=None)
            return await interaction.followup.send("Заявка уже обработана.", ephemeral=True)

        role_row = await self.bot.db.fetchone("SELECT value FROM guild_settings WHERE guild_id = ? AND key = 'staff_role'", interaction.guild.id)
        internship_role_name = role_row["value"] if role_row else "Стажер"
        
        internship_role = discord.utils.get(interaction.guild.roles, name=internship_role_name)
        if not internship_role:
            internship_role = await interaction.guild.create_role(name=internship_role_name, color=discord.Color.blue())

        already_member = await self.bot.db.fetchone("SELECT * FROM staff_members WHERE guild_id = ? AND user_id = ? AND is_active = 1", interaction.guild.id, row["user_id"])
        if not already_member:
            await self.bot.db.execute("INSERT INTO staff_members (guild_id, user_id, role, added_by) VALUES (?, ?, ?, ?)", interaction.guild.id, row["user_id"], row["role"], interaction.user.id)
        
        await self.bot.db.execute("UPDATE staff_applications SET status = 'accepted', reviewed_by = ?, reviewed_at = CURRENT_TIMESTAMP WHERE id = ?", interaction.user.id, row["id"])

        await interaction.message.edit(view=None)

        member = interaction.guild.get_member(self.user_id)
        
        await self.send_public_verdict(interaction, True, None, internship_role_name)
        
        # ЛОГИКА ОДОБРЕНИЯ: Только здесь выдаём роль и создаём каналы
        if member:
            if internship_role not in member.roles:
                await member.add_roles(internship_role, reason="Начало стажировки по заявке")

            text_channel, stage_channel, is_created = await self.get_or_create_shared_tribunes(interaction.guild, internship_role)
            
            if text_channel:
                ping_msg = await text_channel.send(f"🎉 Новый стажер! {member.mention} присоединился к команде! Добро пожаловать!")
                await asyncio.sleep(5)
                try:
                    await ping_msg.delete()
                except:
                    pass

            if is_created and text_channel:
                embed = discord.Embed(
                    title="🎤 Добро пожаловать на стажировку!",
                    description=(
                        f"Поздравляем с одобрением!\n\n"
                        f"Вы и другие кандидаты были приглашены в общий канал.\n"
                        f"**Сцена для обсуждения и голосования:** {stage_channel.mention if stage_channel else 'Создается...'}\n\n"
                        f"Здесь пройдет финальный этап проверки!"
                    ),
                    color=discord.Color.blue()
                )
                await text_channel.send(embed=embed)

        msg = await interaction.followup.send("✅ Заявка одобрена! Роль выдана.", ephemeral=False)
        await asyncio.sleep(2)
        try:
            await msg.delete()
        except:
            pass

    @discord.ui.button(label="❌ Отклонить", style=discord.ButtonStyle.danger)
    async def reject_button(self, interaction: discord.Interaction, button: discord.ui.Button):
        # ЛОГИКА ОТКЛОНЕНИЯ: Никаких ролей и каналов!
        if not self.is_admin(interaction.user):
            return await interaction.response.send_message("⛔ У вас нет прав для вердикта.", ephemeral=True)
        
        row = await self.bot.db.fetchone("SELECT * FROM staff_applications WHERE application_number = ? AND guild_id = ? AND status = 'pending'", self.app_number, interaction.guild.id)
        if not row:
            await interaction.message.edit(view=None)
            return await interaction.response.send_message("Заявка уже обработана.", ephemeral=True)

        await interaction.response.send_modal(StaffPrivateRejectModal(self.bot, self.app_number, self.user_id, self.role, self.role_name))

    async def get_or_create_shared_tribunes(self, guild: discord.Guild, internship_role: discord.Role):
        category = discord.utils.get(guild.categories, name="༺𓆩《📂》・Набор в штат")
        if not category:
            category = await guild.create_category("༺𓆩《📂》・Набор в штат")

        overwrites = {
            guild.default_role: discord.PermissionOverwrite(read_messages=False, connect=False),
            internship_role: discord.PermissionOverwrite(read_messages=True, send_messages=True, connect=True, speak=True, request_to_speak=True),
            guild.me: discord.PermissionOverwrite(read_messages=True, send_messages=True, connect=True, speak=True, request_to_speak=True)
        }
        for m in guild.members:
            if m.guild_permissions.administrator:
                overwrites[m] = discord.PermissionOverwrite(read_messages=True, send_messages=True, connect=True, speak=True, request_to_speak=True)

        is_created = False
        
        text_channel = discord.utils.get(category.channels, name="🗣・собеседование")
        if not text_channel:
            text_channel = await guild.create_text_channel(
                name="🗣・собеседование",
                category=category,
                overwrites=overwrites,
                topic="Общая стажировка для всех кандидатов. Обсуждение и проверка."
            )
            is_created = True

        stage_channel = discord.utils.get(category.channels, name="🎙・трибуна")
        if not stage_channel:
            stage_channel = await guild.create_stage_channel(
                name="🎙・трибуна",
                category=category,
                overwrites=overwrites
            )
            is_created = True

        return text_channel, stage_channel, is_created

    async def send_public_verdict(self, interaction: discord.Interaction, accepted: bool, reason: str = None, internship_role_name: str = "Стажер"):
        member = interaction.guild.get_member(self.user_id)
        if not member:
            return

        if accepted:
            embed = discord.Embed(
                title="✅ ЗАЯВКА ОДОБРЕНА",
                description=(
                    f"**Ваша заявка на роль `{self.role_name}` одобрена!**\n\n"
                    f"Мы рассмотрели вашу заявку и приняли решение пригласить вас в наш отряд!\n"
                    f"Добро пожаловать в команду!\n\n"
                    f"Вам была выдана роль **{internship_role_name}**. Пройдите в канал `🗣・собеседование` в категории `Набор в штат` для продолжения."
                ),
                color=discord.Color.green()
            )
            embed.add_field(name="👤 Рассмотрел", value=interaction.user.mention, inline=False)
        else:
            embed = discord.Embed(
                title="❌ ЗАЯВКА ОТКЛОНЕНА",
                description=(
                    f"**Ваша заявка на роль `{self.role_name}` была отклонена.**\n\n"
                    f"Мы ценим ваш интерес, однако, к сожалению, вынуждены отказать вам.\n"
                    f"Спасибо за проявленное внимание!"
                ),
                color=discord.Color.red()
            )
            embed.add_field(name="👤 Рассмотрел", value=interaction.user.mention, inline=False)
            if reason:
                embed.add_field(name="📄 Комментарий / Причина", value=reason, inline=False)

        embed.set_footer(text="Система набора Horizon")
        
        try:
            await member.send(embed=embed)
        except discord.Forbidden:
            pass

    def is_admin(self, member: discord.Member) -> bool:
        return member.guild_permissions.administrator or member.guild.owner_id == member.id



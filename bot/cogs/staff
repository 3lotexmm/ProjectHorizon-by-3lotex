# ГЛАВНЫЙ КОГ (С КОМАНДАМИ УПРАВЛЕНИЯ + reload_staff_logic)
# ==========================================
class Staff(commands.Cog):
    def __init__(self, bot: commands.Bot):
        self.bot = bot
        self.staff_category_name = "༺𓆩《📂》・Набор в штат"

    async def create_wide_banner(self, guild: discord.Guild):
        try:
            image_path = os.path.join("assets", "images", "banner.png")
            
            if not os.path.exists(image_path):
                logger.error(f"Файл {image_path} не найден!")
                return None
                
            return discord.File(image_path, filename="banner.png")
            
        except Exception as e:
            logger.error(f"Ошибка при загрузке баннера: {e}")
            return None

    @commands.hybrid_command(name="staffrole", aliases=["рольстажера"], description="Установить роль для стажировки")
    async def staff_role(self, ctx: commands.Context, *, role_name: str):
        await ctx.message.delete()

        if not ctx.author.guild_permissions.administrator:
            return await ctx.send(embed=discord.Embed(title="⛔ НЕДОСТАТОЧНО ПРАВ", color=discord.Color.red()), delete_after=3)
        
        role = discord.utils.get(ctx.guild.roles, name=role_name)
        if not role:
            return await ctx.send(f"❌ Роль **{role_name}** не найдена на сервере.", delete_after=3)
        
        await self.bot.db.execute(
            "INSERT OR REPLACE INTO guild_settings (guild_id, key, value) VALUES (?, 'staff_role', ?)",
            ctx.guild.id, role_name
        )
        await ctx.send(f"✅ Роль для стажеров установлена: **{role_name}**", delete_after=3)

    @commands.hybrid_command(name="reloadstaff", aliases=["перезагрузитьнабор"], description="Перезагрузить меню набора (если бот перезапустился)")
    async def reload_staff(self, ctx: commands.Context):
        await ctx.message.delete()

        if not ctx.author.guild_permissions.administrator:
            return await ctx.send(embed=discord.Embed(title="⛔ НЕДОСТАТОЧНО ПРАВ", color=discord.Color.red()), delete_after=3)
        
        row = await self.bot.db.fetchone("SELECT value FROM guild_settings WHERE guild_id = ? AND key = 'apply_channel'", ctx.guild.id)
        if not row:
            return await ctx.send("❌ Канал набора не найден в БД. Используйте !staffsetup.", delete_after=3)
        
        channel = ctx.guild.get_channel(int(row["value"]))
        if not channel:
            return await ctx.send("❌ Канал набора не найден на сервере.", delete_after=3)

        async for msg in channel.history(limit=20):
            if msg.author == self.bot.user and msg.components:
                try:
                    await msg.delete()
                except:
                    pass

        embed = discord.Embed(
            title="**Набор в персонал сервера Horizon Clan!**", 
            description=(
                "> Ты **проводишь много времени** на нашем сервере и хочешь стать частью "
                "**элитной команды**? Это твой шанс!\n\n"
                "**⚔️ Выбери желаемую должность** из списка ниже и **заполни анкету**.\n"
                "Мы внимательно рассмотрим твою заявку и свяжемся с тобой!"
            ),
            color=0x2b2d31 
        )
        
        banner_file = await self.create_wide_banner(ctx.guild)
        if banner_file:
            embed.set_image(url="attachment://banner.png")
        
        bot_image = str(self.bot.user.display_avatar.url) if self.bot.user and self.bot.user.display_avatar else None
        embed.set_footer(text="Horizon Clan • Набор в Staff", icon_url=bot_image)
        
        if banner_file:
            await channel.send(embed=embed, view=StaffApplicationView(self.bot), file=banner_file)
        else:
            await channel.send(embed=embed, view=StaffApplicationView(self.bot))

        await ctx.send("✅ Меню набора успешно перезагружено!", delete_after=3)

    @commands.hybrid_command(name="stopstaff", aliases=["закрытьнабор"], description="Закрыть набор (меню пропадает)")
    async def stop_staff(self, ctx: commands.Context):
        await ctx.message.delete()

        if not ctx.author.guild_permissions.administrator:
            return await ctx.send(embed=discord.Embed(title="⛔ НЕДОСТАТОЧНО ПРАВ", color=discord.Color.red()), delete_after=3)
        
        await self.bot.db.execute(
            "INSERT OR REPLACE INTO guild_settings (guild_id, key, value) VALUES (?, 'staff_status', 'stopped')",
            ctx.guild.id
        )
        
        row = await self.bot.db.fetchone("SELECT value FROM guild_settings WHERE guild_id = ? AND key = 'apply_channel'", ctx.guild.id)
        if row:
            channel = ctx.guild.get_channel(int(row["value"]))
            if channel:
                async for msg in channel.history(limit=10):
                    if msg.author == self.bot.user and msg.components:
                        try:
                            await msg.delete()
                        except:

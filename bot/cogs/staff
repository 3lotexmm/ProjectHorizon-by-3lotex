class StaffApplicationView(discord.ui.View):
    def __init__(self, bot: commands.Bot):
        # timeout=None = кнопки никогда не пропадут сами по себе
        super().__init__(timeout=None)
        self.bot = bot
        
        select = discord.ui.Select(
            placeholder="📋 Выберите желаемую должность",
            min_values=1,
            max_values=1,
            options=[
                discord.SelectOption(label="Администратор", value="admin", description="Управление сервером и персоналом", emoji="🛡️"),
                discord.SelectOption(label="Модератор", value="moderator", description="Следить за порядком на сервере", emoji="🔨"),
                discord.SelectOption(label="Хелпер", value="helper", description="Помощь новым участникам", emoji="💡"),
            ]
        )
        select.callback = self.select_callback
        self.add_item(select)

    async def select_callback(self, interaction: discord.Interaction):
        role = interaction.data["values"][0]
        role_names = {"admin": "Администратор", "moderator": "Модератор", "helper": "Хелпер"}
        role_name = role_names.get(role, role)

        # Проверяем статус набора
        status_row = await self.bot.db.fetchone("SELECT value FROM guild_settings WHERE guild_id = ? AND key = 'staff_status'", interaction.guild.id)
        is_active = status_row is None or status_row["value"] == "active"
        
        if not is_active:
            return await interaction.response.send_message("❌ Набор в штат временно приостановлен! Ожидайте возобновления.", ephemeral=True)

        is_admin = interaction.user.guild_permissions.administrator

        if not is_admin:
            existing = await self.bot.db.fetchone("SELECT * FROM staff_members WHERE guild_id = ? AND user_id = ? AND is_active = 1", interaction.guild.id, interaction.user.id)
            if existing:
                return await interaction.response.send_message("❌ Вы уже в штате.", ephemeral=True)

            existing_app = await self.bot.db.fetchone("SELECT * FROM staff_applications WHERE guild_id = ? AND user_id = ? AND status = 'pending'", interaction.guild.id, interaction.user.id)
            if existing_app:
                return await interaction.response.send_message("⚠️ У вас уже есть активная заявка! Ожидайте решения.", ephemeral=True)
        
        await interaction.response.send_modal(StaffApplicationModal(self.bot, role, role_name))


class StaffApplicationModal(discord.ui.Modal, title="📝 Анкета в штат"):
    def __init__(self, bot: commands.Bot, role: str, role_name: str):
        super().__init__()
        self.bot = bot
        self.role = role
        self.role_name = role_name
    
    age = discord.ui.TextInput(label="🎂 Возраст", placeholder="Например: 18", required=True, min_length=1, max_length=3)
    experience = discord.ui.TextInput(label="💼 Опыт работы", placeholder="Ваш опыт модерации/администрирования", required=True, style=discord.TextStyle.paragraph, max_length=500)
    about = discord.ui.TextInput(label="👤 О себе", placeholder="Почему вы хотите стать частью команды?", required=True, style=discord.TextStyle.paragraph, max_length=1000)
    timezone = discord.ui.TextInput(label="🌍 Часовой пояс", placeholder="Например: UTC+3 (Москва)", required=True, max_length=50)
    availability = discord.ui.TextInput(label="⏰ Доступность", placeholder="Сколько часов в день готовы уделять?", required=True, max_length=100)
    
    async def on_submit(self, interaction: discord.Interaction):
        try:
            age = int(self.age.value)
            if age < 17:
                return await interaction.response.send_message("❌ Вы слишком молоды. Требуемый возраст: 17+", ephemeral=True)
        except ValueError:
            return await interaction.response.send_message("❌ Неверный возраст.", ephemeral=True)
        
        row = await self.bot.db.fetchone("SELECT COALESCE(MAX(application_number), 0) + 1 AS next FROM staff_applications WHERE guild_id = ?", interaction.guild.id)
        app_number = row["next"]
        
        await self.bot.db.execute(
            """INSERT INTO staff_applications (guild_id, user_id, role, age, experience, about, timezone, availability, status, application_number) 
               VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?)""",
            interaction.guild.id, interaction.user.id, self.role, age, self.experience.value, self.about.value, self.timezone.value, self.availability.value, app_number
        )

        embed = discord.Embed(description=f"✅ **Заявка #{app_number:04d} принята!**\n\nВаша заявка на роль **{self.role_name}** была отправлена на рассмотрение. Ожидайте вердикта.", color=discord.Color.green())
        await interaction.response.send_message(embed=embed, ephemeral=True)
        
        await self.send_to_private_channel(interaction.guild, interaction.user, app_number, age, self.experience.value, self.about.value, self.timezone.value, self.availability.value, self.role, self.role_name)

    async def send_to_private_channel(self, guild, user, app_number, age, experience, about, timezone, availability, role, role_name):
        row = await self.bot.db.fetchone("SELECT value FROM guild_settings WHERE guild_id = ? AND key = 'private_applications'", guild.id)
        if not row: return
        channel = guild.get_channel(int(row["value"]))
        if not channel: return
            
        embed = discord.Embed(
            description=(
                f"🔒 **НОВАЯ ЗАЯВКА #{app_number:04d}**\n\n"
                f"**Пользователь:** {user.mention}\n"
                f"**ID:** {user.id}\n\n"
                f"🎂 **Возраст:** `{age}`\n"
                f"🌍 **Часовой пояс:** `{timezone}`\n"
                f"⏰ **Доступность:** `{availability}`\n\n"
                f"💼 **Опыт работы:**\n{experience}\n\n"
                f"👤 **О себе:**\n{about}"
            ),
            color=discord.Color.dark_gold()
        )
        
        view = StaffPrivateVerdictView(self.bot, app_number, user.id, role, role_name)
        await channel.send(embed=embed, view=view)



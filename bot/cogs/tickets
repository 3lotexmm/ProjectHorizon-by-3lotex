# ==========================================
# МЕНЮ ВЫБОРА ТЕМЫ (С УДАЛЕНИЕМ СООБЩЕНИЙ ВНУТРИ НЕГО)
# ==========================================
class TicketSelectView(discord.ui.View):
    def __init__(self, bot: commands.Bot):
        super().__init__(timeout=None)
        self.bot = bot
        self.category = None
        
        select = discord.ui.Select(
            placeholder="Выберите тему обращения...",
            min_values=1,
            max_values=1,
            options=[
                discord.SelectOption(label="⚖️ Жалоба", description="Пожаловаться на нарушителя", emoji="⚖️"),
                discord.SelectOption(label="❓ Вопрос", description="Задать вопрос администрации", emoji="❓"),
                discord.SelectOption(label="💻 Техническая проблема", description="Ошибка или баг", emoji="💻"),
                discord.SelectOption(label="📜 Другое", description="Свой вариант", emoji="📜"),
            ]
        )
        select.callback = self.select_callback
        self.add_item(select)

    async def select_callback(self, interaction: discord.Interaction):
        self.category = interaction.data["values"][0]
        
        await interaction.response.send_message(
            f"📌 **Вы выбрали:** `{self.category}`\n\n"
            f"👋 Теперь, пожалуйста, **напишите причину** вашего обращения в этот чат.\n"
            f"⏳ У вас есть **30 секунд**, чтобы подробно описать суть проблемы.\n\n"
            f"*(Ваше сообщение будет автоматически удалено из этого чата и перенесено в новый тикет)*",
            ephemeral=True
        )

        def check(m):
            return m.author == interaction.user and m.channel == interaction.channel

        async def auto_delete():
            await asyncio.sleep(10)
            try:
                await interaction.delete_original_response()
            except:
                pass
        asyncio.create_task(auto_delete())

        try:
            msg = await self.bot.wait_for('message', timeout=30.0, check=check)
            reason_text = msg.content
            
            try:
                await msg.delete()
            except:
                pass

            try:
                await interaction.delete_original_response()
            except:
                pass

            await self._create_ticket(interaction, self.category, reason_text)

        except asyncio.TimeoutError:
            timeout_msg = await interaction.followup.send("⏰ **Время вышло**. Вы не успели написать причину. Пожалуйста, начните заново, нажав на кнопку.")
            await asyncio.sleep(4)
            await timeout_msg.delete()
            try:
                await interaction.delete_original_response()
            except:
                pass
            return

    async def _create_ticket(self, interaction: discord.Interaction, category_choice: str, reason_text: str):
        guild = interaction.guild
        member = interaction.user
        
        row = await self.bot.db.fetchone("SELECT COALESCE(MAX(ticket_number), 0) + 1 AS next FROM tickets WHERE guild_id = ?", guild.id)
        ticket_num = row["next"] if row else 1

        cat_name = "🎫 ТИКЕТЫ"
        category = discord.utils.get(guild.categories, name=cat_name)
        if category is None:
            category = await guild.create_category(cat_name)

        overwrites = {
            guild.default_role: discord.PermissionOverwrite(read_messages=False, connect=False),
            member: discord.PermissionOverwrite(read_messages=True, send_messages=True, connect=True, speak=True),
            guild.me: discord.PermissionOverwrite(read_messages=True, send_messages=True, connect=True, speak=True)
        }
        
        support_role = discord.utils.get(guild.roles, name="Support")
        if support_role:
            overwrites[support_role] = discord.PermissionOverwrite(read_messages=True, send_messages=True, connect=True, speak=True)

        text_name = f"ticket-{ticket_num:04d}"
        voice_name = f"🎙 ticket-{ticket_num:04d}"

        try:
            text_channel = await guild.create_text_channel(text_name, category=category, overwrites=overwrites)
            voice_channel = await guild.create_voice_channel(voice_name, category=category, overwrites=overwrites)
            
            await self.bot.db.execute(
                "INSERT INTO tickets (guild_id, ticket_number, channel_id, creator_id, subject) VALUES (?, ?, ?, ?, ?)",
                guild.id, ticket_num, text_channel.id, member.id, category_choice
            )

            banner_path = os.path.join("assets", "images", "banner.png")
            banner_file = None
            if os.path.exists(banner_path):
                banner_file = discord.File(banner_path, filename="banner.png")

            embed = discord.Embed(
                title=f"📩 Новый тикет создан | #{ticket_num:04d}",
                description=(
                    f"👤 **Создатель:** {member.mention} (ID: `{member.id}`)\n"
                    f"📂 **Категория:** {category_choice}\n"
                    f"📝 **Причина:**\n```{reason_text}```\n\n"
                    f"🛡️ Команда поддержки скоро ответит вам в этом канале.\n"
                    f"🎙️ Если вам удобнее общаться голосом, зайдите в созданный голосовой канал."
                ),
                color=0x2ecc71
            )
            
            if banner_file:
                embed.set_image(url="attachment://banner.png")

            embed.set_footer(text=f"Система тикетов v1.5.0 • ID тикета #{ticket_num:04d}")
            
            await text_channel.send(
                f"👋 {member.mention} | {support_role.mention if support_role else ''}",
                embed=embed,
                view=CloseTicketView(self.bot),
                file=banner_file if banner_file else None
            )

            await interaction.followup.send(f"✅ Тикет #{ticket_num:04d} успешно создан! Перейдите в {text_channel.mention}", ephemeral=True)

        except Exception as e:
            await interaction.followup.send(f"❌ **Ошибка при создании тикета:** `{e}`", ephemeral=True)


# ==========================================
# КНОПКИ ЗАКРЫТИЯ ТИКЕТА
# ==========================================
class CloseTicketView(discord.ui.View):
    def __init__(self, bot: commands.Bot):
        super().__init__(timeout=None)
        self.bot = bot

    @discord.ui.button(label="🔒 Закрыть тикет", style=discord.ButtonStyle.danger)
    async def close_ticket_callback(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.send_message("🔒 **Тикет закрывается...**", ephemeral=True)
        await self._close_ticket_flow(interaction.channel, interaction.user)

    @staticmethod
    async def start_inactivity_timer(text_channel, guild):
        await asyncio.sleep(1800)
        if text_channel is None or not guild.get_channel(text_channel.id):
            return
        
        last_message = None
        async for msg in text_channel.history(limit=1):
            last_message = msg
            break
        
        if last_message and not last_message.author.bot:
            time_diff = (discord.utils.utcnow() - last_message.created_at).total_seconds()
            if time_diff < 1800:
                await CloseTicketView.start_inactivity_timer(text_channel, guild)
                return
        
        await text_channel.send("⏰ **Тикет автоматически закрыт из-за неактивности.**")
        await CloseTicketView._close_ticket_flow(text_channel, None)

    async def _close_ticket_flow(self, text_channel, closer_user):
        guild = text_channel.guild
        author_id_str = text_channel.topic
        
        await text_channel.set_permissions(guild.default_role, read_messages=False, send_messages=False)
        support_role = discord.utils.get(guild.roles, name="Support")
        if support_role:
            await text_channel.set_permissions(support_role, read_messages=False, send_messages=False)

        await text_channel.send("🔒 **Тикет закрыт.** Канал будет удалён через **10 секунд**.")
        await asyncio.sleep(10)

        transcript_lines = []
        async for msg in text_channel.history(limit=1000):
            if not msg.author.bot:
                transcript_lines.append(f"[{msg.created_at.strftime('%H:%M:%S')}] {msg.author.display_name}: {msg.content}")
        transcript_text = "\n".join(transcript_lines[::-1]) if transcript_lines else "Нет сообщений"

        config = await self.bot.db.fetchone("SELECT value FROM guild_settings WHERE guild_id = ? AND key = 'ticket_log_channel'", guild.id)
        if config:
            log_channel = guild.get_channel(int(config["value"]))
            if log_channel:
                ticket_num = text_channel.name.split('-')[1]
                author_mention = f"<@{author_id_str}>" if author_id_str else "Неизвестен"
                closer_text = "Система (30 минут бездействия)" if closer_user is None else closer_user.mention
                
                log_embed = discord.Embed(
                    title="📋 Лог закрытого тикета",
                    description=f"Информация о закрытом тикете.",
                    color=0x95a5a6,
                    timestamp=discord.utils.utcnow()
                )
                log_embed.add_field(name="📁 Номер тикета", value=f"#{ticket_num}", inline=True)
                log_embed.add_field(name="👤 Автор", value=author_mention, inline=False)
                log_embed.add_field(name="🔒 Закрыл", value=closer_text, inline=False)
                log_embed.add_field(name="💬 Сообщений", value=len(transcript_lines), inline=True)
                log_embed.set_footer(text="Система тикетов v1.5.0")
                await log_channel.send(embed=log_embed)
                
                file = discord.File(io.BytesIO(transcript_text.encode('utf-8')), filename=f"{text_channel.name}_log.txt")
                await log_channel.send(file=file)

        voice_channel = discord.utils.get(guild.voice_channels, name=f"🎙 {text_channel.name}")
        await text_channel.delete()
        if voice_channel:
            await voice_channel.delete()

        if author_id_str:
            await self.bot.db.execute(
                "INSERT OR REPLACE INTO guild_settings (guild_id, key, value) VALUES (?, 'user_cooldown', ?)",
                guild.id, author_id_str
            )


# ==========================================
# ОСНОВНОЙ КОГ ТИКЕТОВ (АДМИНСКИЕ КОМАНДЫ)
# ==========================================
class Tickets(commands.Cog):
    def __init__(self, bot: commands.Bot):
        self.bot = bot
        self.ticket_category_name = "🎫 ТИКЕТЫ"

    @commands.hybrid_command(name="setup-ticket", aliases=["setupticket"], description="Создать панель тикетов в текущем канале")
    @commands.has_permissions(administrator=True)
    async def setup_ticket(self, ctx: commands.Context):
        guild = ctx.guild
        cat_name = "🎫 ТИКЕТЫ"
        category = discord.utils.get(guild.categories, name=cat_name)
        if category is None:
            category = await guild.create_category(cat_name)

        support_channel = discord.utils.get(category.channels, name="📩 Поддержка Horizon Clan")
        if not support_channel:
            support_channel = await guild.create_text_channel("📩 Поддержка Horizon Clan", category=category)

        log_channel = discord.utils.get(category.channels, name="📁・tick-log")
        if not log_channel:
            overwrites = {
                guild.default_role: discord.PermissionOverwrite(read_messages=False),
                guild.me: discord.PermissionOverwrite(read_messages=True, send_messages=True)
            }
            for member in guild.members:
                if member.guild_permissions.administrator or member == guild.owner:
                    overwrites[member] = discord.PermissionOverwrite(read_messages=True, send_messages=True)
            log_channel = await guild.create_text_channel("📁・tick-log", category=category, overwrites=overwrites)

        await self.bot.db.execute("INSERT OR REPLACE INTO guild_settings (guild_id, key, value) VALUES (?, 'ticket_support_channel', ?)", ctx.guild.id, str(support_channel.id))
        await self.bot.db.execute("INSERT OR REPLACE INTO guild_settings (guild_id, key, value) VALUES (?, 'ticket_log_channel', ?)", ctx.guild.id, str(log_channel.id))

        # ==========================================
        # ЗАГРУЗКА БАННЕРА В КАНАЛ ПОДДЕРЖКИ (НАД МЕНЮШКОЙ)
        # ==========================================
        banner_path = os.path.join("assets", "images", "banner.png")
        banner_file = None
        if os.path.exists(banner_path):
            banner_file = discord.File(banner_path, filename="banner.png")

        embed = discord.Embed(
            title="📩 Поддержка Horizon Clan",
            description=(
                "Добро пожаловать в систему поддержки Horizon Clan!\n"
                "Здесь вы можете оставить жалобу, задать вопрос или сообщить о технической проблеме.\n\n"
                "⬇️ **Выберите тему обращения из списка ниже:**"
            ),
            color=0x3498db
        )
        embed.set_footer(text="Система тикетов v1.5.0")
        
        if banner_file:
            embed.set_image(url="attachment://banner.png")

        await support_channel.send(
            embed=embed,
            view=TicketSelectView(self.bot),
            file=banner_file if banner_file else None
        )

        await ctx.send(f"✅ Панель настроена! Перейдите в {support_channel.mention}", ephemeral=True)

    @commands.hybrid_command(name="remove-ticket", aliases=["removeticket"], description="Удалить панель тикетов из текущего канала")
    @commands.has_permissions(administrator=True)
    async def remove_ticket(self, ctx: commands.Context):
        async for msg in ctx.channel.history(limit=20):
            if msg.author == ctx.guild.me and msg.embeds and "Поддержка Horizon Clan" in msg.embeds[0].title:
                await msg.delete()
                await ctx.send("✅ Панель тикетов удалена из этого канала.", ephemeral=True)
                return
        await ctx.send("❌ Панель не найдена в этом канале.", ephemeral=True)

    @commands.hybrid_command(name="restart-ticket", aliases=["restartticket"], description="Пересоздать панель тикетов в текущем канале")
    @commands.has_permissions(administrator=True)
    async def restart_ticket(self, ctx: commands.Context):
        async for msg in ctx.channel.history(limit=20):
            if msg.author == ctx.guild.me and msg.embeds and "Поддержка Horizon Clan" in msg.embeds[0].title:
                await msg.delete()
                break
        embed = discord.Embed(
            title="📩 Поддержка Horizon Clan",
            description=(
                "Добро пожаловать в систему поддержки Horizon Clan!\n"
                "Здесь вы можете оставить жалобу, задать вопрос или сообщить о технической проблеме.\n\n"
                "⬇️ **Выберите тему обращения из списка ниже:**"
            ),
            color=0x3498db
        )
        embed.set_footer(text="Система тикетов v1.5.0")
        await ctx.send(embed=embed, view=TicketSelectView(self.bot))

    @commands.hybrid_command(name="setup-logs", aliases=["setuplogs"], description="Настроить канал для логов тикетов")
    @commands.has_permissions(administrator=True)
    async def setup_logs(self, ctx: commands.Context, channel: discord.TextChannel):
        await self.bot.db.execute(
            "INSERT OR REPLACE INTO guild_settings (guild_id, key, value) VALUES (?, 'ticket_log_channel', ?)",
            ctx.guild.id, str(channel.id)
        )
        await ctx.send(f"✅ Канал логов установлен: {channel.mention}", ephemeral=True)

    @commands.hybrid_command(name="remove-logs", aliases=["removelogs"], description="Отвязать канал логов")
    @commands.has_permissions(administrator=True)
    async def remove_logs(self, ctx: commands.Context):
        await self.bot.db.execute(
            "DELETE FROM guild_settings WHERE guild_id = ? AND key = 'ticket_log_channel'",
            ctx.guild.id
        )
        await ctx.send("✅ Канал логов отвязан.", ephemeral=True)

    @commands.hybrid_command(name="adduser", description="Добавить участника в текущий открытый тикет")
    @commands.has_permissions(administrator=True)
    async def adduser(self, ctx: commands.Context, member: discord.Member):
        if "ticket-" not in ctx.channel.name:
            await ctx.send("❌ Эта команда работает только внутри каналов тикетов!", ephemeral=True)
            return
        overwrites = ctx.channel.overwrites
        overwrites[member] = discord.PermissionOverwrite(read_messages=True, send_messages=True)
        await ctx.channel.edit(overwrites=overwrites)
        ticket_num = ctx.channel.name.split('-')[1]
        await ctx.send(f"✅ Пользователь {member.mention} добавлен в тикет #{ticket_num}.", ephemeral=True)
        await ctx.channel.send(f"👋 {member.mention}, вы были добавлены в этот тикет командой поддержки!")

    # ==========================================
    # АВТО-ВОССТАНОВЛЕНИЕ ДЛЯ БОТА (ЧТОБЫ НЕ ПРОПАДАЛО МЕНЮ)
    # ==========================================
    async def tick_reset_logic(self, guild: discord.Guild):
        """Восстанавливает панель тикетов после перезагрузки бота."""
        row = await self.bot.db.fetchone("SELECT value FROM guild_settings WHERE guild_id = ? AND key = 'ticket_support_channel'", guild.id)
        if not row:
            logger.warning(f"Тикеты: канал поддержки не найден для {guild.name}")
            return

        channel = guild.get_channel(int(row["value"]))
        if not channel:
            logger.warning(f"Тикеты: канал не найден на сервере {guild.name}")
            return

        async for msg in channel.history(limit=10):
            if msg.author == guild.me and msg.embeds and "Поддержка Horizon Clan" in msg.embeds[0].title:
                try:
                    await msg.delete()
                except:
                    pass

        banner_path = os.path.join("assets", "images", "banner.png")
        banner_file = None
        if os.path.exists(banner_path):
            banner_file = discord.File(banner_path, filename="banner.png")

        embed = discord.Embed(
            title="📩 Поддержка Horizon Clan",
            description=(
                "Добро пожаловать в систему поддержки Horizon Clan!\n"
                "Здесь вы можете оставить жалобу, задать вопрос или сообщить о технической проблеме.\n\n"
                "⬇️ **Выберите тему обращения из списка ниже:**"
            ),
            color=0x3498db
        )
        embed.set_footer(text="Система тикетов v1.5.0")
        
        if banner_file:
            embed.set_image(url="attachment://banner.png")

        await channel.send(
            embed=embed,
            view=TicketSelectView(self.bot),
            file=banner_file if banner_file else None
        )
        logger.info(f"Тикеты восстановлены на {guild.name}")


async def setup(bot: commands.Bot):
    await bot.add_cog(Tickets(bot))

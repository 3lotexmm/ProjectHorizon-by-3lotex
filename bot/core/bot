    async def on_member_update(self, before: discord.Member, after: discord.Member):
        if before.nick != after.nick:
            details = {
                "change_type": "nickname_change",
                "old_value": before.nick,
                "new_value": after.nick,
            }
            await self.event_bus.publish_event(
                guild_id=after.guild.id,
                log_type="moderation",
                action="nickname_change",
                actor_id=after.id,
                target_id=after.id,
                source="system",
                details=details,
            )
        added_roles = set(after.roles) - set(before.roles)
        removed_roles = set(before.roles) - set(after.roles)
        for role in added_roles:
            details = {
                "change_type": "role_add",
                "role_id": role.id,
                "role_name": role.name,
            }
            await self.event_bus.publish_event(
                guild_id=after.guild.id,
                log_type="moderation",
                action="role_add",
                target_id=after.id,
                source="system",
                details=details,
            )
        for role in removed_roles:
            details = {
                "change_type": "role_remove",
                "role_id": role.id,
                "role_name": role.name,
            }
            await self.event_bus.publish_event(
                guild_id=after.guild.id,
                log_type="moderation",
                action="role_remove",
                target_id=after.id,
                source="system",
                details=details,
            )

    async def on_guild_channel_update(self, before: discord.abc.GuildChannel, after: discord.abc.GuildChannel):
        changes = []
        if before.name != after.name:
            changes.append({"change_type": "name", "old_value": before.name, "new_value": after.name})
        if getattr(before, "position", None) != getattr(after, "position", None):
            changes.append({"change_type": "position", "old_value": getattr(before, "position", None), "new_value": getattr(after, "position", None)})

        for change in changes:
            details = {
                "entity": "channel",
                "entity_id": after.id,
                "change_type": change["change_type"],
                "old_value": change["old_value"],
                "new_value": change["new_value"],
                "channel_type": str(after.type),
            }
            await self.event_bus.publish_event(
                guild_id=after.guild.id,
                log_type="server_update",
                action="channel_update",
                source="system",
                details=details,
            )


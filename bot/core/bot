    async def on_voice_state_update(self, member: discord.Member, before: discord.VoiceState, after: discord.VoiceState):
        if before.channel == after.channel:
            return

        if before.channel is None and after.channel is not None:
            action = "voice_join"
        elif before.channel is not None and after.channel is None:
            action = "voice_leave"
        else:
            action = "voice_move"

        details = {
            "from_channel_id": before.channel.id if before.channel else None,
            "from_channel_name": before.channel.name if before.channel else None,
            "to_channel_id": after.channel.id if after.channel else None,
            "to_channel_name": after.channel.name if after.channel else None,
            "action": action,
        }
        await self.event_bus.publish_event(
            guild_id=member.guild.id,
            log_type="voice",
            action=action,
            target_id=member.id,
            source="system",
            details=details,
        )

    async def on_guild_update(self, before: discord.Guild, after: discord.Guild):
        if before.name != after.name:
            details = {"entity": "guild", "change_type": "name", "old_value": before.name, "new_value": after.name}
            await self.event_bus.publish_event(
                guild_id=after.id,
                log_type="server_update",
                action="guild_update",
                source="system",
                details=details,
            )
        if before.icon != after.icon:
            details = {"entity": "guild", "change_type": "icon", "old_value": str(before.icon), "new_value": str(after.icon)}
            await self.event_bus.publish_event(
                guild_id=after.id,
                log_type="server_update",
                action="guild_update",
                source="system",
                details=details,
            )


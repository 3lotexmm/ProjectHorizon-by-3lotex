    async def setup_hook(self):
        await self.event_bus.connect()
        await self.audit_logger.start()
        await self.db.connect()

        await self.load_extension('bot.cogs.tickets')
        await self.load_extension('bot.cogs.staff')
        await self.load_extension('bot.cogs.moderation')
        await self.load_extension('bot.cogs.help')
        await self.load_extension('bot.cogs.error_handler')
        logger.info("Cogs loaded")

        try:
            await self.tree.sync()
            logger.info("Slash commands synced")
        except Exception as e:
            logger.warning(f"Failed to sync slash commands: {e}")

    async def on_ready(self):
        logger.info(f"Logged in as {self.user} (ID: {self.user.id})")
        logger.info(f"Serving {len(self.guilds)} guilds")
        
        self.loop.create_task(self.rotate_status())

        # ==========================================
        # АВТО-ВОССТАНОВЛЕНИЕ ЧЕРЕЗ 10 СЕКУНД
        # ==========================================
        self.loop.create_task(self.auto_restore())

    async def auto_restore(self):
        await asyncio.sleep(10)
        logger.info("🔄 Авто-восстановление: запуск...")

        for guild in self.guilds:
            try:
                # Тикеты
                tickets_cog = self.get_cog("Tickets")
                if tickets_cog:
                    await tickets_cog.tick_reset_logic(guild)
            except Exception as e:
                logger.warning(f"⚠️ Ошибка авто-восстановления тикетов: {e}")

            try:
                # Штат
                staff_cog = self.get_cog("Staff")
                if staff_cog:
                    await staff_cog.reload_staff_logic(guild)
            except Exception as e:
                logger.warning(f"⚠️ Ошибка авто-восстановления штата: {e}")

    async def rotate_status(self):
        while True:
            try:
                shuffled = self.statuses.copy()
                random.shuffle(shuffled)
                
                for status_type, text in shuffled[:10]:
                    if status_type == "watching":
                        activity = discord.Activity(type=discord.ActivityType.watching, name=text)
                    elif status_type == "playing":
                        activity = discord.Activity(type=discord.ActivityType.playing, name=text)
                    elif status_type == "listening":
                        activity = discord.Activity(type=discord.ActivityType.listening, name=text)
                    elif status_type == "competing":
                        activity = discord.Activity(type=discord.ActivityType.competing, name=text)
                    else:
                        activity = discord.Streaming(name=text, url="https://twitch.tv/3lotex")
                    
                    await self.change_presence(activity=activity)
                    await asyncio.sleep(random.randint(15, 45))
                
                await asyncio.sleep(60)
                
            except asyncio.CancelledError:
                break
            except Exception as e:
                logger.error(f"Status rotation error: {e}")
                await asyncio.sleep(60)

    async def close(self):
        try:
            await self.audit_logger.stop()
        except:
            pass
        try:
            await self.event_bus.close()
        except:
            pass
        try:
            await self.db.close()
        except:
            pass
        try:
            await super().close()
        except:
            pass

    async def on_member_join(self, member: discord.Member):
        details = {
            "user": {
                "id": member.id,
                "name": str(member),
                "avatar_url": str(member.display_avatar.url) if member.display_avatar else None,
            },
            "account_created_at": member.created_at.isoformat(),
        }
        await self.event_bus.publish_event(
            guild_id=member.guild.id,
            log_type="join",
            action="join",
            target_id=member.id,
            source="system",
            details=details,
        )

